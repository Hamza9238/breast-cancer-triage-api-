# ─── Naive Dockerfile (Dockerfile.naive) ───
# The simplest working Dockerfile: starts from ubuntu, installs everything,
# copies the whole project, trains inside the image, and runs the API.

FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and pip
RUN apt-get update && \
    apt-get install -y python3 python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the entire project directory
COPY . .

# Install all dependencies (training + serving)
RUN pip3 install --no-cache-dir -r requirements-train.txt -r requirements-serve.txt

# Train the model inside the image
RUN python3 training/train.py --data-path data/raw/breast_cancer.csv --output-dir artifacts --model-version 1.0.0

# Expose port
EXPOSE 8000

# Start the API
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
