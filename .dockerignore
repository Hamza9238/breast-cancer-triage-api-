# Ignore version control
.git
.dvc

# Ignore Python artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
dist/
build/

# Ignore dev and docs files
.env
.env.example
*.md
requirements-dev.txt
Dockerfile*
docker-compose*.yml
.dockerignore
.gitignore
.dvcignore

# Ignore DVC remote (data already restored via dvc pull before build)
dvc-remote/

# Ignore model artifacts (generated during build)
artifacts/

