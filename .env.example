# ─── Environment Variables ───
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to Git.

# Docker Hub username (used to name the image)
DOCKER_USERNAME=yourdockerhubusername

# Image tag for builds and pushes
IMAGE_TAG=latest

# Model version string
MODEL_VERSION=1.0.0

# Git commit SHA (set automatically during CI or manually)
GIT_SHA=unknown

# Host port to expose the API on
HOST_PORT=8000

# Decision threshold for malignant classification (0.0 – 1.0)
DECISION_THRESHOLD=0.5

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
